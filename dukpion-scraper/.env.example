# Copy to .env and edit. All values optional except USER_AGENT contact.
DUKPION_USER_AGENT=DukpionResearchBot/0.1 (contact: you@example.com)
DUKPION_REQUEST_DELAY_MIN=3
DUKPION_REQUEST_DELAY_MAX=6
DUKPION_MAX_RETRIES=3
DUKPION_REQUEST_TIMEOUT=30
DUKPION_MAX_CONCURRENT_REQUESTS=2
# Comma-separated category slugs to include even if they don't look like eyewear
DUKPION_EXTRA_CATEGORY_SLUGS=
# Comma-separated category slugs to always skip
DUKPION_EXCLUDE_CATEGORY_SLUGS=
# Image downloads are sequential; delay between image requests (seconds)
DUKPION_IMAGE_DELAY_MIN=1.5
DUKPION_IMAGE_DELAY_MAX=3
