# Copy to .env to change settings. Every line is optional.

# Name shown in the page header, the page title and on saved pictures.
TRYON_SITE_NAME=TryOn

# Web server.
TRYON_HOST=127.0.0.1
TRYON_PORT=8000

# Largest photo accepted, in megabytes.
TRYON_MAX_UPLOAD_MB=12

# How many people can use the live 3D camera at the same time. Each one is a video stream the server's CPU has to track,
# so keep this low on a small machine.
TRYON_MAX_LIVE=4
